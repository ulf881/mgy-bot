TOKEN=discordTokenHere

YOUTUBE_API_KEY=youtubeHere

# Optional: external JS runtime(s) for yt-dlp YouTube challenges (comma separated).
# e.g. YTDLP_JS_RUNTIMES=quickjs (requires a recent `qjs` on PATH, minimum 2025-4-26)
# Deno is the yt-dlp default when this is empty.
YTDLP_JS_RUNTIMES=

DB_HOST=127.0.0.1
DB_USER=postgres
DB_PASSWORD=root
DB_NAME=postgres

SPOTIPY_CLIENT_ID=spotifyClient
SPOTIPY_CLIENT_SECRET=spotifySecret

TWITCH_CLIENT_ID=twitchClientId
TWITCH_CLIENT_SECRET=twitchClientSecret
TWITCH_OAUTH_TOKEN=twitchOauthNotRequired

NAME="MGY!"
MACRO="Isaac Best Game."
MACRO2="Isaac Best Game."

# rule34: use scraping by default. Fill these to use the official API instead:
# R34_USER_ID=r34UserId
# R34_API_KEY=r34ApiKey
